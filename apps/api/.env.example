# development | production
NODE_ENV=development
PORT=3000

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# Firebase Admin SDK
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# Cloudflare R2
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# AI Server — uvek localhost (interni poziv, ne izlaže se javno)
AI_SERVER_URL=http://localhost:8000
AI_INTERNAL_API_KEY=
AI_ALLOWED_IMAGE_ORIGINS=

# Admin bootstrap (comma-separated)
ADMIN_EMAILS=
ADMIN_FIREBASE_UIDS=

# Security / limits
TRUST_PROXY=
JSON_BODY_LIMIT=1mb
MAX_IMAGE_PIXELS=24000000
MAX_IMAGE_WIDTH=8000
MAX_IMAGE_HEIGHT=8000
MAX_REMOTE_IMAGE_BYTES=10485760

# Sentry (Error Monitoring)
SENTRY_DSN=https://935178231beab79f12226217f095eddd@o4511162324811776.ingest.de.sentry.io/4511162327302224
