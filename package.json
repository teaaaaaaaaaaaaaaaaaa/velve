{
  "name": "velve",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:mobile": "npm run start --workspace=apps/mobile",
    "dev:mobile:web": "node scripts/start-mobile-web-preview.js",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:ai": "npm run dev --workspace=apps/ai-server",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "android": "npm run android --workspace=apps/mobile",
    "ios": "npm run ios --workspace=apps/mobile"
  },
  "devDependencies": {
    "expo": "~54.0.0",
    "eslint": "^8.50.0",
    "prettier": "^3.0.3"
  },
  "version": "1.0.0",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.33",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-reanimated": "4.1.1",
    "react-native-worklets": "0.5.1"
  },
  "overrides": {
    "@xmldom/xmldom": "0.9.10",
    "fast-uri": "3.1.2",
    "fast-xml-builder": "1.2.0",
    "fast-xml-parser": "5.8.0",
    "postcss": "8.5.14",
    "protobufjs": "7.5.8"
  }
}
